      ],
      "evaluator_limitations": [
        "The current atomic evaluator has no separate taxonomy atoms for all Radical Zone mechanic-local multiplier, zone-overwrite, duration, removal, coexistence, Sonority, and non-consumption rules; these approved semantics are retained with pinned source anchors but are not independently scored."
      ],
      "fact_id": "passive:9fb47053d32547d0b8de",
      "owner_context": "Treat this witness primarily as a shared-mechanic-definition test, not as evidence that Myunfa herself directly owns every behavior described by Radical Zone.",
      "shared_mechanic_semantics": [
        {
          "owner_note": "A defined zone that is already Another Zone can still be awakened into Radical Zone.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Can be awaken if defined zone is Another Zone"
          }
        },
        {
          "owner_note": "Radical Zone changes Zone damage multipliers to the stated +60% / +100% values by zone category.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Doubles damage multiplicators for Zones : to +60% for Attack Zones and Thunder, Crystal, Shade (other elements) Type Zones to +100% for Fire, Water, Wind, Earth and Shade Type Zones"
          }
        },
        {
          "owner_note": "Crystal/Shade Type Zone weakness/resistance effects are doubled as stated.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Doubles \"damage on weakness/resist\" effects for Crystal/Shade Type Zone respectively"
          }
        },
        {
          "owner_note": "Radical Zone cannot be overwritten while active.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Zone cannot be overwritten by other zones during the duration"
          }
        },
        {
          "owner_note": "Its duration cannot be extended by attempting to activate Another Zone or Radical Zone again.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "duration cannot be extended by attempting to activate Another Zone or reactivate R. Zone"
          }
        },
        {
          "owner_note": "It can still be removed/broken by skills that remove zones.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Zone can still be removed/broken by skills that remove zones"
          }
        },
        {
          "owner_note": "It is removed after its duration ends.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "After duration ends, zone is removed"
          }
        },
        {
          "owner_note": "Support Effects can coexist with Radical Zone.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Support Effects can be used at the same time as R. Zone"
          }
        },
        {
          "owner_note": "Sonority effects are strengthened while Radical Zone is active.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Sonority effects will be strengthen in R. Zone"
          }
        },
        {
          "owner_note": "When no appropriate zone exists, or the zone is already awakened, an attempted active-skill awakening does not consume the awakening ability.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "When there is no appropriate zone or the zone is already awakened, using a skill that can \"awaken\" R. Zone will not consume awakening ability"
          }
        },
        {
          "owner_note": "Non-active skill sources may activate it more than once per battle when explicitly stated.",
          "source_anchor": {
            "location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
            "quote": "Non-active skill sources may activate it more than once per battle if explicitly stated"
          }
        }
      ],
      "source_capture_sha256": "72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f",
      "source_location": "sha256:72826f0caea2f281ca1c8ca4f8a3b5bc1cc69cd9b00c2426db2375056a57b85f/grid[14]/block[0]",
      "witness_id": "fresh-myunfa-alter-radical-zone"
