NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=your-neo4j-auth
ETL_MODE=strict

# LLM provider toggle (choose one):
#   openrouter  (default) — Uses OpenRouter proxy for all workflow nodes; requires OPENROUTER_API_KEY
#   anthropic             — Uses Claude API; requires ANTHROPIC_API_KEY
#   bedrock               — Uses AWS Bedrock; requires AWS credentials in env
#   ollama                — Uses local Ollama server; zero API cost
LLM_PROVIDER=openrouter



# Required when LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional: set a smaller/faster model for the validation gate; defaults to OPENROUTER_MODEL.
# OPENROUTER_VALIDATOR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama model to use when LLM_PROVIDER=ollama (default: llama3.2)
OLLAMA_MODEL=llama3.2

# Admin API key — required by /admin/reindex and other admin-only routes.
# Generate any strong random string; clients must send this as the X-Admin-Key header.
ADMIN_KEY=your-admin-secret-here

# FastAPI / Uvicorn server settings (optional — defaults shown)
# HOST=127.0.0.1
# PORT=8000
