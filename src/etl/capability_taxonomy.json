  "review_states": ["approve", "reject", "correct", "ambiguous"],
  "rules": [
    {"id":"cap-zone-deploy","phase":"defensive_setup","kind":"capability","value":"deploy_zone","record_types":["skill","passive"],"pattern":"\\b(?:deploy|set|establish|activate)s? (?:an? )?(?:[a-z]+ )?(?:zone|stance)\\b","negative_patterns":["\\bawaken(?:s|ed|ing)? (?:the )?(?:[a-z]+ )?(?:zone|stance)","requires? (?:an? )?(?:awakened )?(?:zone|stance)","while (?:an? )?(?:zone|stance)"],"direction":"field","target":"zone"},
    {"id":"cap-zone-awaken","phase":"defensive_setup","kind":"capability","value":"awaken_zone","record_types":["skill","passive"],"pattern":"\\bawaken(?:s|ing)? (?:the )?(?:[a-z]+ )?(?:zone|stance)\\b","negative_patterns":["requires? awakened"],"direction":"field","target":"zone"},
    {"id":"cap-mitigation","phase":"defensive_setup","kind":"capability","value":"damage_reduction","record_types":["skill","passive"],"pattern":"\\b(?:damage (?:taken )?(?:reduced|reduction)|reduce(?:s)? damage (?:taken )?by)\\b","negative_patterns":["enemy damage reduction","barrier","shield","barrier pierc"],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-damage-reduction-barrier","phase":"defensive_setup","kind":"capability","value":"damage_reduction_barrier","record_types":["skill","passive"],"pattern":"\\b(?:damage reduction barrier|barrier .{0,40}(?:reduce|reduction)|(?:reduce|reduction).{0,40} barrier)\\b","negative_patterns":["barrier pierc"],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-shield","phase":"defensive_setup","kind":"capability","value":"shield","record_types":["skill","passive"],"pattern":"\\b(?:grant|give|apply|stack|restore)s? .{0,30}shield(?: hp)?\\b|\\bshield hp\\b","negative_patterns":["doesn't count","does not count","barrier pierc"],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-ally-resistance","phase":"defensive_setup","kind":"capability","value":"ally_resistance_up","record_types":["skill","passive"],"pattern":"\\b(?:type|physical|magic|elemental) resistance (?:of )?(?:all party members|party|all allies|allies|user) (?:up|increased)|(?:all party members|party|all allies|allies) (?:type|physical|magic|elemental) resistance [+-]?\\d+%","negative_patterns":["enemy|foe"],"direction":"ally","target":"party"},
    {"id":"cap-heal","phase":"defensive_setup","kind":"capability","value":"heal_hp","record_types":["skill","passive"],"pattern":"\\b(?:restore|recover)s? (?:all party members' |all allies' |party |user(?:'s)? )?hp|\\bheal(?:s|ing)?\\b","negative_patterns":["healing power","increase damage and healing","damage and healing of all party members","regen","end of turn","^Poison Smoke II\\b"],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-regen-hp","phase":"defensive_setup","kind":"capability","value":"regen_hp","record_types":["skill","passive"],"pattern":"\\b(?:hp regen|regen(?:erate)?s? hp|restore hp at (?:the )?end of (?:each )?turn)\\b","negative_patterns":[],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-remove-status-ailment","phase":"defensive_setup","kind":"capability","value":"remove_status_ailment","record_types":["skill","passive"],"pattern":"\\b(?:remove|restore|cleanse)s? (?:all )?(?:status(?: effects?|es)?|ailments?)\\b","negative_patterns":["immunity"],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-remove-debuff","phase":"defensive_setup","kind":"capability","value":"remove_debuff","record_types":["skill","passive"],"pattern":"\\b(?:remove|restore|cleanse)s? (?:all )?debuffs?\\b","negative_patterns":[],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-status-immunity","phase":"defensive_setup","kind":"capability","value":"grant_status_immunity","record_types":["skill","passive"],"pattern":"\\b(?:status immunity|immunity to status|block(?:s)? status)\\b","negative_patterns":["barrier pierc"],"direction":"ally","target":"party"},
    {"id":"cap-taunt","phase":"defensive_setup","kind":"capability","value":"taunt","record_types":["skill","passive"],"pattern":"\\b(?:taunt|rage|redirect attacks)\\b","negative_patterns":["^Flaming Rage\\b","^Rage(?: - Counter)?\\b"],"direction":"enemy","target":"all_enemies"},
    {"id":"cap-knockback-immunity","phase":"defensive_setup","kind":"capability","value":"knockback_immunity","record_types":["skill","passive"],"pattern":"\\b(?:knockback immunity|immune to knockback|prevent(?:s)? knockback)\\b","negative_patterns":[],"direction":"ally","target":"main_and_reserve"},
    {"id":"cap-hold-ground","phase":"defensive_setup","kind":"capability","value":"hold_ground","record_types":["skill","passive"],"pattern":"\\bhold ground\\b|\\bsurvive .{0,30}(?:lethal|fatal|0 hp)\\b","negative_patterns":[],"direction":"ally","target":"self"},
    {"id":"cap-revive","phase":"defensive_setup","kind":"capability","value":"revive","record_types":["skill","passive"],"pattern":"\\b(?:revive|resurrect|restore .{0,20}from ko)\\b","negative_patterns":[],"direction":"ally","target":"one_ally"},
    {"id":"cap-cover","phase":"defensive_setup","kind":"capability","value":"cover","record_types":["skill","passive"],"pattern":"\\b(?:activate|grant|apply|enter)s? cover\\b|\\bcover(?:s|ing)? (?:an? |all )?all(?:y|ies)\\b","negative_patterns":[],"direction":"ally","target":"self"},
